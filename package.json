{
  "name": "document360-competitive-intel",
  "version": "2.0.0",
  "private": true,
  "description": "Self-owned competitive-intelligence dashboard for Document360 and 6 competitors. Provenance-tracked mention monitoring across 6 channels, Claude-measured AI answer visibility, and evidence-cited recommendations. No Brand24, no third-party monitoring connector.",
  "scripts": {
    "test": "node test/smoke.js",
    "start": "node server.js",
    "collect": "node collectors/collect.js --days=365",
    "collect:90": "node collectors/collect.js --days=90",
    "collect:linkedin": "node collectors/collect.js --days=90 --only=linkedin",
    "collect:x": "node collectors/collect.js --days=90 --only=x_twikit",
    "reverify:legacy": "node collectors/reverify-legacy.js",
    "resolve:feeds": "node collectors/resolve-feeds.js",
    "build:data": "node collectors/build.js",
    "queue:sentiment": "node collectors/claude/queue.js build",
    "apply:sentiment": "node collectors/claude/queue.js apply",
    "queue:ai": "node collectors/claude/ai-visibility.js build",
    "apply:ai": "node collectors/claude/ai-visibility.js apply",
    "measure:serp": "node collectors/claude/ai-visibility.js serp",
    "queue:recs": "node collectors/claude/recommend.js build",
    "apply:recs": "node collectors/claude/recommend.js apply",
    "searxng:up": "docker compose -f collectors/searxng/docker-compose.yml up -d",
    "searxng:down": "docker compose -f collectors/searxng/docker-compose.yml down",
    "setup:python": "node collectors/setup-python.js",
    "searxng:local": "node collectors/searxng/run-local.js",
    "searxng:status": "node collectors/searxng/run-local.js --status",
    "refresh:hourly": "node collectors/refresh-hourly.js",
    "refresh:once": "node collectors/refresh-hourly.js --once",
    "refresh:status": "node collectors/refresh-service.js status",
    "searxng:engines": "node collectors/searxng/probe-engines.js",
    "refresh:start": "node collectors/refresh-service.js start",
    "refresh:stop": "node collectors/refresh-service.js stop",
    "batch": "node collectors/claude/batch.js",
    "dedupe": "node collectors/dedupe-store.js",
    "auth:init": "node collectors/auth-init.js",
    "auth:status": "node -e \"console.log(JSON.stringify(require(\"./collectors/lib/auth\").status(),null,2))\"",
    "discover": "node collectors/discover-competitors.js",
    "discover:recent": "node collectors/discover-competitors.js --keywords=16 --recent",
    "brightdata:probe": "node collectors/brightdata-probe.js",
    "collect:linkedin:bd": "node collectors/collect.js --days=365 --only=linkedin_brightdata",
    "collect:linkedin:company": "node collectors/collect.js --days=365 --only=linkedin_brightdata --stages=company",
    "assets:build": "node collectors/claude/rank-assets.js build",
    "assets:apply": "node collectors/claude/rank-assets.js apply",
    "digest": "node collectors/daily-digest.js run",
    "digest:preview": "node collectors/daily-digest.js preview",
    "digest:status": "node collectors/daily-digest.js status",
    "digest:schedule": "node collectors/daily-digest.js schedule",
    "api:health": "node collectors/api-health.js",
    "api:health:paid": "node collectors/api-health.js --paid",
    "dfs:balance": "node -e \"require('./collectors/lib/env').load();require('./collectors/lib/dataforseo').balance().then(b=>console.log(JSON.stringify(b,null,2)))\"",
    "audit:mentions": "node collectors/audit-mentions.js",
    "audit:mentions:live": "node collectors/audit-mentions.js --live",
    "windsor:probe": "node collectors/windsor-probe.js probe",
    "windsor:enrich": "node collectors/windsor-probe.js enrich",
    "directories": "node collectors/directory-audit.js",
    "directories:resolve": "node collectors/directory-audit.js --resolve",
    "vercel-build": "node -e \"require('./server.js');console.log('handler loads')\"",
    "session:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "deploy:check": "node collectors/deploy-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuryaVenkataSubramanian/CompetitorIntelligence.git"
  }
}
