      "id": "competitor_intent",
      "label": "Competitor / Alternative Intent",
      "priority": 3,
      "discovery_value": "Highest-yield: alternative and 'best' queries return curated product lists, which is exactly where a new entrant first appears.",
      "keywords": [
        "documentation platform alternative", "documentation software alternative",
        "knowledge base alternative", "knowledge management alternative",
        "Confluence alternative", "GitBook alternative", "Mintlify alternative",
        "Guru alternative", "Bloomfire alternative", "KnowledgeOwl alternative",
        "Document360 alternative", "documentation tools comparison",
