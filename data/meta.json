        "qualifier_terms": false,
        "qualifier_terms_note": "Bing largely ignores qualifier words: '\"Bloomfire\" sponsor conference' returned 10 Bloomfire homepages and no sponsorship page. Event-sponsorship detection is therefore not viable here.",
        "date_filter": false,
