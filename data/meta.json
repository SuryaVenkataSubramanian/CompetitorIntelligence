    "global": [
      "SearXNG is not running, so SERP-based discovery, Google News link resolution, the Events channel and the Web/AI-Overview column are all unavailable. Start it: docker compose -f collectors/searxng/docker-compose.yml up -d"
    ],
    "by_range": {
      "7": [],
      "30": [],
      "90": [
        "GDELT is at the edge of its ~90-day window here; some older news may be missing."
      ],
      "365": [
        "GDELT news indexing covers only a ~90-day rolling window, so 365-day web/news counts are thinner than reality."
      ]
    },
    "by_channel": {
      "blog": [
        "GitBook, Guru, KnowledgeOwl publish no discoverable RSS feed, so their blog coverage depends on SearXNG/GDELT discovery and is less complete than brands with a feed."
      ],
      "linkedin": [
        "The 507 LinkedIn record(s) shown come from SearXNG `site:linkedin.com` discovery, which finds only publicly indexed posts — so this is a FLOOR, not a total. The credential-based collector (joeyism/linkedin_scraper) is not connected, so engagement metrics (reactions, comments, reposts) are unavailable and non-indexed posts are missed."
      ],
      "x": [
        "The 82 X record(s) shown come from SearXNG `site:x.com` discovery, which finds only publicly indexed posts — a FLOOR, not a total. The credential-based collector (twikit) is not connected, so like/repost counts are unavailable and unindexed posts are missed."
      ],
      "event": [
        "Event sponsorship is detected by requiring BOTH a brand name and a sponsorship term on a fetched page — sponsorship is exposed by no API. 89 record(s) passed. Mere attendance or a speaking slot is deliberately not counted as sponsorship, so this under-reports event presence."
      ]
    },
    "dormant": [
      {
        "adapter": "linkedin",
        "label": "LinkedIn company posts",
        "blockers": [
          "LINKEDIN_LI_AT not set — LinkedIn channel is not connected."
        ],
        "how_to_enable": "Log in to LinkedIn, copy the `li_at` cookie value from DevTools → Application → Cookies, put it in .env as LINKEDIN_LI_AT, then run: npm run collect:linkedin",
        "fallback_in_use": "SearXNG `site:linkedin.com` discovery supplies partial LinkedIn coverage without credentials. It finds publicly indexed posts only, so counts are a floor, not a total."
      },
      {
        "adapter": "x_twikit",
        "label": "X / Twitter (twikit)",
        "blockers": [
          "X channel not connected — missing X_USERNAME, X_EMAIL, X_PASSWORD."
