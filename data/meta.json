  "caveats": {
    "global": [
      "Web search for this build was served by the built-in Node metasearch, not SearXNG. built-in metasearch: duckduckgo(10), bing(10). No Docker or Python required, but materially weaker than SearXNG: Intermittent. DuckDuckGo serves a CAPTCHA after roughly 10-15 queries; Bing degrades to unrelated results once it flags the host. Both are detected and discarded rather than stored, so counts are a floor and a thin result set may mean throttling rather than competitor silence. It cannot serve the linkedin, x, event channels at all, because neither engine honours the site: operator or qualifier terms.",
      "SearXNG is not running, so SERP-based discovery, Google News link resolution, the Events channel and the Web/AI-Overview column are all unavailable. Start it: docker compose -f collectors/searxng/docker-compose.yml up -d"
    ],
    "by_range": {
      "7": [],
      "30": [],
      "90": [
        "GDELT is at the edge of its ~90-day window here; some older news may be missing."
      ],
      "365": [
        "GDELT news indexing covers only a ~90-day rolling window, so 365-day web/news counts are thinner than reality."
      ]
    },
    "by_channel": {
      "linkedin": [
        "Not measurable with the current SERP provider (the built-in metasearch does not honour site: or qualifier terms). Run SearXNG — npm run searxng:local — to populate this channel."
