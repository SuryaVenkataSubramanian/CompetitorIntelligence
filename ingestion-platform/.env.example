# ===========================================================================
# Brand Mention Ingestion Platform
#
# Everything below the REQUIRED block is optional. The platform runs with only
# DATABASE_URL and SEARXNG_BASE_URL set: Bluesky, Hacker News and the Reddit
# replicas are keyless, and they carry most of the coverage.
# ===========================================================================


# ------------------------------------------------------------------ REQUIRED

DATABASE_URL=postgresql://user:pass@host:5432/mentions

# Self-hosted SearXNG. The instance MUST have JSON output enabled:
#
#   search:
#     formats:
#       - html
#       - json
#
# A stock instance serves HTML only and answers a JSON request with 403. The
# adapter detects that specific case and says so, rather than reporting an empty
# result — but it is the most common setup mistake, so check it first.
SEARXNG_BASE_URL=https://searxng.internal.example.com


# ------------------------------------- OPTIONAL — semantic relevance filtering
#
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio. Only worth running
# when the brand name is a common word (Apple, Notion, Linear, Guru); for a
# distinctive name the deterministic word-boundary tier is as accurate and free.
#
# If unreachable at runtime the pipeline falls through to word-boundary matching
# and RECORDS that it did. It does not admit everything at half confidence.

LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3:8b


# ----------------------------------------------- OPTIONAL — headless rendering
#
# Only used off-Lambda. On Vercel the adapter loads @sparticuz/chromium instead
# and ignores this. Note that Chromium fitting in a Lambda layer does not solve
# the other half: Google serves CAPTCHA interstitials to AWS IP ranges at a high
# rate, so AI Overview coverage is markedly better from a VPS.

LOCAL_CHROMIUM_PATH=/usr/bin/google-chrome


# ------------------------------------------------------------ OPTIONAL — Reddit
#
# A descriptive, non-generic User-Agent is mandatory for Reddit's own endpoints.
# Generic agents from cloud IPs are rate-limited on the first request. Format:
#   <platform>:<app id>:<version> (by /u/<account>)

REDDIT_USER_AGENT=node:brand-mention-ingestion:v1.0 (by /u/your_account)


# ==========================================================================
# OPTIONAL — AUTHENTICATED PLANE
#
# READ §11 BEFORE SETTING ANY OF THESE. Leave them blank unless a specific,
# named business need justifies the exposure. With them unset, LinkedIn is
# still collected through SERP dorking, which needs no account.
#
#   - Account suspension is the EXPECTED steady state, not a risk. Use a
#     burner account you can afford to lose. Never a personal or executive one.
#   - This breaches the platform ToS you accepted at signup. That is a
#     contractual matter; proxy rotation does not change it. Worth a
#     conversation with counsel before production, especially for a commercial
#     product rather than internal monitoring.
#   - Author names, handles and post bodies from EU/UK data subjects are
#     personal data under GDPR whether or not they were public. You need a
#     lawful basis, a retention policy and an erasure path.
#   - These are LIVE ACCOUNT CREDENTIALS. Encrypt at rest, scope database
#     access tightly, and never log them.
#   - Expect to re-export every 2-4 weeks as sessions are invalidated.
#
# LinkedIn: sign in, then DevTools > Application > Cookies > linkedin.com.
# JSESSIONID is stored WITH literal double quotes ("ajax:1234567890"). Paste it
# exactly as shown — the adapter strips them for the csrf-token header and keeps
# them for the cookie header, which is the difference between 200 and 403.
# ==========================================================================

LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# X / Twitter via a twikit companion container. X rotates GraphQL query IDs and
# Webpack chunk layouts every 2-4 weeks, so pin an actively maintained fork and
# run it out-of-process — an in-process client takes the whole app down with it
# when the protocol moves.
TWIKIT_SERVER_URL=http://localhost:19816
