# ============================================================================
# Document360 Competitive Intelligence — environment
#
# Copy to .env and fill in. EVERY value here is server-side only: nothing under
# public/ imports the env loader, and no API route echoes a key. `npm test`
# enforces that by scanning frontend code and API payloads for each literal
# value.
#
# On Vercel, set these as Environment Variables in the project settings
# instead — do not commit a .env.
# ============================================================================

PORT=3000

# ---------------------------------------------------------------- AI Visibility
# DataForSEO — the only source that can measure ChatGPT / Claude / Gemini /
# Perplexity / Google AI Overview. Without it those surfaces report
# "not checked", never "not visible".
#   DATAFORSEO_B64 is base64("login:password").
#   Or set DATAFORSEO_LOGIN + DATAFORSEO_PASSWORD and it is encoded at runtime.
DATAFORSEO_B64=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Spend guards. These calls are billable (~$0.18 for a six-surface probe), so a
# probe is capped and a reserve is held back. A blocked call reports
# "not checked — budget", never a silent empty result.
DATAFORSEO_MAX_PROBE_COST=0.25
DATAFORSEO_MIN_BALANCE=0.05

# --------------------------------------------------------------- first-party
# Windsor.ai — Google Analytics 4, YouTube and LinkedIn Ads for our OWN
# properties. Measures the OUTCOME of AI visibility (sessions that actually
# arrived from an assistant) and is free to query, so it is also the fallback
# when the DataForSEO balance runs out.
WINDSOR_API_KEY=

# ------------------------------------------------------------------- mentions
# Octolens social listening. NOTE: it returns mentions only for keywords
# configured in the Octolens account, so products it does not watch are
# "not measured" rather than zero.
OCTOLENS_API_KEY=

# NewsAPI. Developer plan retrieves page 1 only and returns a ~200-char content
# snippet; both bound coverage.
NEWSAPI_KEY=

# Bright Data — LinkedIn / Reddit / YouTube / X post scraping via the Web
# Scraper API. The /request (Web Unlocker) API additionally needs a zone
# provisioned in the Bright Data control panel; without one it reports
# unavailable. Discover what a token can reach with: npm run brightdata:probe
BRIGHTDATA_API_KEY=

# ---------------------------------------------------------------------- search
# SearXNG powers web discovery, the review-directory audit and the free SERP
# fallback. It is a LOCAL service — start it with `npm run searxng:local`.
# Serverless hosts cannot reach localhost, so those collectors are local-only.
SEARXNG_URL=http://localhost:8888
SERP_PROVIDER=auto

# -------------------------------------------------------------------- sessions
# HMAC key for stateless signed session cookies. REQUIRED in any serverless
# deployment: without it sessions live in process memory and every cold start
# logs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------- digest
# Daily new-competitor digest recipient.
DIGEST_TO=
# SMTP is optional. Without it the digest is still generated and stored under
# data/digests/ — it is simply not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------ deployment
# Set to "readonly" on a serverless host. It makes endpoints that need a
# writable filesystem or a child process say so explicitly, instead of failing
# in a way that looks like missing data. Vercel sets VERCEL=1 automatically and
# the server detects that too.
DEPLOY_MODE=
