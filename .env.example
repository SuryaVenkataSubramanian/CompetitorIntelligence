# ############################################################################
# DO NOT PASTE THIS FILE INTO VERCEL.
#
# 24 of the 30 keys below are intentionally BLANK placeholders. Vercel accepts
# a blank value, stores the variable, and then fails the deploy with:
#
#     Environment variable "SESSION_SECRET" is invalid.
#
# and, if you then try to add the real value on top of it:
#
#     A variable with the name SESSION_SECRET already exists for the
#     targets production and preview
#
# Neither message mentions that the value is empty, which makes it a slow
# thing to diagnose.
#
# Use this instead. It emits ONLY the 6 variables Vercel needs, all non-empty,
# each validated against the constraints Vercel enforces:
#
#     npm run env:vercel              show them
#     npm run env:vercel -- --out     write .env.vercel to copy from
#     npm run env:vercel -- --cli     exact vercel CLI commands
#     npm run env:vercel -- --skip=SESSION_SECRET   omit what is already set
#
# This file is documentation, and a template for a local .env. Nothing more.
# ############################################################################


# ============================================================================
# Document360 Competitive Intelligence — environment
#
# Every variable appears EXACTLY ONCE below, grouped by where it belongs.
# Nothing here is read by browser code: no file under public/ imports the env
# loader and no API route echoes a key. `npm test` enforces that by scanning
# frontend code and every API payload for each literal value.
#
# THREE TARGETS, DIFFERENT NEEDS — do not paste this whole file into Vercel.
#
#   [VERCEL]  set in Vercel → Settings → Environment Variables
#   [ACTIONS] set as GitHub repository secrets (Settings → Secrets → Actions)
#   [LOCAL]   only meaningful on your machine; pointless or harmful elsewhere
#
# `npm run deploy:check` verifies this file has no duplicate or conflicting
# keys and tells you which target each one belongs to.
# ============================================================================


# ===========================================================================
# [VERCEL] REQUIRED — the hosted app will not serve without these two
# ===========================================================================

# HMAC key for stateless signed session cookies.
# Serverless gives every request a possibly-new process, so an in-memory
# session map would sign the team out at random. Without this key nobody stays
# logged in. Generate with: npm run session:secret
SESSION_SECRET=

# The provisioned accounts, as JSON.
# collectors/store/auth-users.json is gitignored (it holds scrypt hashes and
# per-user salts), so a fresh deploy has no accounts and every login would be
# rejected. Paste that file's entire contents here — one line.
# It contains hashes and salts, never a password.
AUTH_USERS_JSON=


# ===========================================================================
# [VERCEL] [ACTIONS] AI Visibility + first-party traffic
# The hosted dashboard measures these live, and the scheduled job uses them too
# ===========================================================================

# DataForSEO — the only source that can measure ChatGPT / Claude / Gemini /
# Perplexity / Google AI Overview. Without it those surfaces report
# "not checked", never "not visible".
#
# SET ONE FORM, NOT BOTH. DATAFORSEO_B64 wins if present; the login/password
# pair is only an alternative for when you do not have the encoded value.
#   base64("login:password")
DATAFORSEO_B64=
# --- alternative to the line above; leave blank if DATAFORSEO_B64 is set ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Spend guards. These calls are billable (~$0.18 for a six-surface probe), so
# one probe is capped and a reserve is held back. A blocked call reports
# "not checked — budget", never a silent empty result.
DATAFORSEO_MAX_PROBE_COST=0.25
DATAFORSEO_MIN_BALANCE=0.05

# Windsor.ai — Google Analytics 4 for our own properties. Measures the OUTCOME
# of AI visibility (sessions that actually arrived from an assistant). Free to
# query, so it is also the fallback when the DataForSEO balance runs out.
WINDSOR_API_KEY=


# ===========================================================================
# ===========================================================================
# [VERCEL] [ACTIONS] Alternate providers
#
# Added 2026-09-10 after Bright Data suspended and DataForSEO ran out of credit
# mid-session. Live state for all of them: npm run probe:providers
# ===========================================================================

# SerpAPI - real Google SERP over plain HTTP.
# PROBED: WORKS. Free Plan, 250 searches/MONTH, site: operator confirmed.
# Its value is being HOSTED: unlike SearXNG it works from a serverless
# function, so SERP-dependent channels stay alive where the app actually runs.
# The quota is the constraint - 250/month is ~8/day, so it cannot serve a
# keyword sweep. SearXNG stays ahead of it for bulk work.
SERPAPI_KEY=
# Reserve held back so an automated sweep cannot leave nothing for an
# interactive query later in the month. A quota stop reports "not checked".
SERPAPI_MIN_REMAINING=20

# ScrapingBee - fetches pages that refuse a plain request.
# PROBED: WORKS, 1000 credits. MEASURED on G2's knowledge-base category page:
#     default        HTTP 500     2,980 bytes   bot-walled, 0 products
#     premium_proxy  HTTP 200     2,562 bytes   bot-walled, 0 products
#     stealth_proxy  HTTP 200   948,680 bytes   17 products
# Stealth is the only mode that works on these hosts, and is selected
# automatically for g2/capterra/trustradius/softwareadvice/gartner/getapp.
SCRAPINGBEE_KEY=
SCRAPINGBEE_MIN_CREDITS=25

# twitterapi.io - X/Twitter with no account login.
# PROBED: WORKS. Three endpoints confirmed HTTP 200 - advanced_search (KEYWORD
# search, which Bright Data could not do), user/last_tweets, user/info. Exact
# createdAt plus like/retweet/reply/quote/view/bookmark counts.
# CREDITS RUN OUT SILENTLY: when exhausted every endpoint returns HTTP 402
# {"error":"Unauthorized","message":"Credits is not enough.Please recharge"} and
# /oapi/my/info reports a NEGATIVE balance. The adapter checks credits before
# its first query so an empty plan reports one billing stop, not 14 failures.
TWITTERAPI_IO_USER_ID=
TWITTERAPI_IO_KEY=

# ScrapeBadger - scraping API. PROBED: WORKS, 998 credits (free tier).
#   POST https://scrapebadger.com/v1/web/scrape
#   x-api-key: <key>      {"url": "...", "format": "markdown"|"html"}
# Note /v1/, NOT /api/v1/. A first pass guessed /api/v1/... paths, got
# "Scraper '<name>' is not configured" on every one, and wrongly concluded the
# product needed a scraper configured in its dashboard. Reading the docs settled
# it. Two real limits: 5 requests/minute on the free tier (a 6th returns 429,
# and the limiter fires BEFORE routing so it is indistinguishable from a wrong
# path), and it declines hard bot walls with 422 blocking_page_detected rather
# than fighting them - which is why ScrapingBee stealth sits behind it.
SCRAPEBADGER_KEY=


# [ACTIONS] Collector credentials
# Collectors do NOT run on Vercel — they are child processes needing minutes
# and a local SearXNG. Setting these in Vercel has no effect. Put them in
# GitHub Actions secrets so the daily job can collect.
# ===========================================================================

# Octolens social listening. Returns mentions only for keywords configured in
# the Octolens account, so a product it does not watch is "not measured"
# rather than zero.
OCTOLENS_API_KEY=

# NewsAPI. The developer plan retrieves page 1 only and returns a ~200-char
# content snippet; both bound coverage.
NEWSAPI_KEY=

# Bright Data — LinkedIn / Reddit / YouTube / X post scraping via the Web
# Scraper API. The /request (Web Unlocker) API additionally needs a zone
# provisioned in the control panel; without one it reports unavailable.
# Discover what a token can reach with: npm run brightdata:probe
BRIGHTDATA_API_KEY=


# ===========================================================================
# [ACTIONS] Daily digest delivery — optional
# Without SMTP the digest is still generated and stored under data/digests/;
# it is simply not emailed.
# ===========================================================================

DIGEST_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ===========================================================================
# [LOCAL] Do not set these in Vercel
# ===========================================================================

# PORT is used by `server.listen()`, which only runs when server.js is executed
# directly. Vercel imports the handler instead, so this is never read there —
# and PORT is a RESERVED system variable on Vercel, which will reject it.
PORT=3000

# SearXNG is a local service. localhost is not reachable from a serverless
# host, so setting this in Vercel points at nothing. It powers web discovery,
# the review-directory audit and the free SERP fallback — all local-only.
SEARXNG_URL=http://localhost:8888
SERP_PROVIDER=auto


# ---------------------------------------------------------------------------
# [LOCAL] Platform credentials for the two dormant adapters.
# Both read a real user session, so they are personal credentials rather than
# service keys — deliberately NOT set anywhere hosted. Leave blank and the
# adapters report themselves dormant with the reason, which is why LinkedIn and
# X coverage currently comes from Bright Data and Octolens instead.
# ---------------------------------------------------------------------------

# LinkedIn `li_at` session cookie, for collectors/adapters/linkedin.js
LINKEDIN_LI_AT=

# X / Twitter sign-in, for collectors/adapters/x_twikit.js (via twikit)
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# ---------------------------------------------------------------------------
# [LOCAL] Refresh-loop tuning. Only read by `npm run refresh:start`, which is a
# long-running local process and has no hosted equivalent.
# ---------------------------------------------------------------------------

# Gap between ticks. Default 3600000 (1 hour).
REFRESH_INTERVAL_MS=
# Brands refreshed per tick, so one tick cannot exhaust engine rate limits.
REFRESH_BRANDS_PER_TICK=
# Look-back window each tick collects. Default 7.
REFRESH_WINDOW_DAYS=
# Port the refresh service health-checks SearXNG on. Default 8888 — keep it
# consistent with the port in SEARXNG_URL above.
SEARXNG_PORT=


# ===========================================================================
# [LOCAL] Optional overrides — leave blank unless you are testing
# ===========================================================================

# Force the read-only posture. Vercel is auto-detected via VERCEL=1, so this is
# only needed to reproduce hosted behaviour on your machine.
DEPLOY_MODE=

# Force a session mode. Auto-detected otherwise: stateless when serverless,
# stateful (opaque server-side tokens, real revocation) when not.
#   values: stateless | stateful
SESSION_MODE=
